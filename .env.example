# Life Dashboard — local environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# ── Deploy / setup (used by deploy/setup.sh) ──────────────────────────────────
PROJECT_ID="your-gcp-project-id"          # GCP project you created for this
REGION="europe-west4"                      # Netherlands — closest to Amsterdam
DOMAIN="dashboard.your-domain.com"        # Domain that will serve the app
IAP_USER="you@yourdomain.com"             # Google account to grant access
GITHUB_REPO="your-github-username/life-dashboard"  # owner/repo on GitHub

# ── Runtime — Flask app (run.py) ──────────────────────────────────────────────
API_KEY="your-dashboard-api-key"          # Secret key for agent/script access
GCS_BUCKET="your-project-id-dashboard-data"   # Private TinyDB bucket
BG_BUCKET="your-project-id-dashboard-bg"      # Public background image bucket
GCP_PROJECT="your-gcp-project-id"        # Same as PROJECT_ID above

# ── Google Calendar sync (optional) ───────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
GCAL_CALENDAR_ID="primary"               # Calendar to sync (primary or full calendar ID)
GCAL_SYNC_DAYS=60                        # How many days ahead to sync

# ── Background generator ───────────────────────────────────────────────────────
GOOGLE_CLOUD_API_KEY="your-vertex-ai-api-key"  # Unlocks Gemini image generation models
FUNCTION_URL="https://bg-generator-xxxx-ez.a.run.app"  # Override for generate_bg.sh
